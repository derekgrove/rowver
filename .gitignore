target/
# The Python package's compiled module, as maturin develop leaves it, and built wheels.
*.so
*.pyd
crates/rowver-py/dist/
# The commit the release writes into the Python source package (pyproject.toml).
crates/rowver-py/COMMIT
__pycache__/
*.egg-info/
build/
dist/
.DS_Store
*.rvr
# The conformance corpus's files are inputs other implementations check themselves against.
!tests/conformance/**/*.rvr
*.md
!README.md
# The documents in docs/, by name: the notes kept beside them stay out of git.
!docs/INTRO.md
!docs/SETUP.md
!docs/FEATURES.md
!docs/FORMAT.md
!docs/SPEC.md

# What the retired Python presser left on this disk (its studies, notes); its code is at tag v13.0.1.
/python/

# The fuzz harness's seeds (fuzz/seed.py makes them again), the corpora it grows, its findings and logs.
/fuzz/seeds/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/logs/
